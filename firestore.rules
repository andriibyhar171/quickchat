rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL SECURITY HELPERS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getChat(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() && request.auth.uid in getChat(chatId).data.participants;
    }

    // =========================================================================
    // DEFAULT DENY
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // USERS COLLECTION: /users/{userId}
    // =========================================================================
    match /users/{userId} {
      allow get, list: if isAuthenticated();

      allow create: if isOwner(userId)
                    && isValidUserDoc(request.resource.data, userId)
                    && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
                    && isValidUserDoc(request.resource.data, userId)
                    // Immutable fields enforcement
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;

      function isValidUserDoc(data, uid) {
        let allowedFields = ['uid', 'displayName', 'email', 'photoURL', 'online', 'lastSeen', 'createdAt'];
        let requiredFields = ['uid', 'displayName', 'online', 'lastSeen', 'createdAt'];

        return data.keys().hasAll(requiredFields)
          && data.keys().hasOnly(allowedFields)
          && data.uid == uid
          && data.displayName is string
          && data.displayName.size() >= 1
          && data.displayName.size() <= 50
          && (!('email' in data) || data.email is string && data.email.size() <= 100)
          && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048))
          && data.online is bool
          && data.lastSeen is timestamp
          && data.createdAt is timestamp;
      }
    }

    // =========================================================================
    // CHATS COLLECTION: /chats/{chatId}
    // =========================================================================
    match /chats/{chatId} {
      allow get, list: if isAuthenticated()
                       && request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.participants
                    && isValidChatDoc(request.resource.data);

      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.participants
                    && isValidChatDoc(request.resource.data)
                    // Participants list must remain immutable on updates
                    && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      function isValidChatDoc(data) {
        let allowedFields = ['participants', 'lastMessage', 'lastMessageTime', 'updatedAt'];
        let requiredFields = ['participants'];

        return data.keys().hasAll(requiredFields)
          && data.keys().hasOnly(allowedFields)
          && data.participants is list
          && data.participants.size() == 2
          && data.participants[0] is string
          && data.participants[1] is string
          && data.participants[0] != data.participants[1]
          && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 2000))
          && (!('lastMessageTime' in data) || data.lastMessageTime is timestamp)
          && (!('updatedAt' in data) || data.updatedAt is timestamp);
      }

      // =======================================================================
      // MESSAGES SUBCOLLECTION: /chats/{chatId}/messages/{messageId}
      // =======================================================================
      match /messages/{messageId} {
        allow get, list: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId)
                      && request.resource.data.senderId == request.auth.uid
                      && isValidMessageDoc(request.resource.data);

        allow update, delete: if false;

        function isValidMessageDoc(data) {
          let allowedFields = ['senderId', 'senderName', 'text', 'timestamp', 'read'];
          let requiredFields = ['senderId', 'senderName', 'text', 'timestamp', 'read'];

          return data.keys().hasAll(requiredFields)
            && data.keys().hasOnly(allowedFields)
            && data.senderId is string
            && data.senderName is string
            && data.senderName.size() >= 1
            && data.senderName.size() <= 50
            && data.text is string
            && data.text.size() >= 1
            && data.text.size() <= 2000
            && data.timestamp is timestamp
            && data.read is bool;
        }
      }
    }
  }
}
